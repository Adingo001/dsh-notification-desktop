{
  "name": "dsh-notification-desktop",
  "version": "0.2.0",
  "description": "Turn-finished desktop notifications for DeepSeek Harness 0.2.x (host session projection + browser Notification, with a settings section).",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adingo001/dsh-notification-desktop.git"
  }
}
